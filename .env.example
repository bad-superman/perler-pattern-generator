# ---- AI 图像生成：默认模型 ----
# 兼容旧变量：AGNES_API_KEY / AGNES_API_BASE / AGNES_MODEL 仍然有效，
# 未设置 AI_DEFAULT_* 时自动回退到它们。
AGNES_API_KEY=your_api_key_here
AGNES_API_BASE=https://apihub.agnes-ai.com/v1/images/generations
AGNES_MODEL=agnes-image-2.1-flash
AGNES_PROXY_PORT=8787

# 如需完全独立配置默认模型，取消注释下列变量（优先级高于 AGNES_*）。
# AI_DEFAULT_PROVIDER 目前仅支持 openai-images（OpenAI images 兼容协议）。
# AI_DEFAULT_PROVIDER=openai-images
# AI_DEFAULT_API_KEY=
# AI_DEFAULT_API_BASE=https://apihub.agnes-ai.com/v1/images/generations
# AI_DEFAULT_MODEL=agnes-image-2.1-flash
# AI_DEFAULT_TIMEOUT_MS=150000

# ---- AI 图像生成：备用模型（fallback）----
# 设置 AI_FALLBACK_MODEL 即启用：默认模型任何失败（报错、超时、未返回图片）都会用备用模型重试一次。
# 其余字段留空则继承默认模型的同名配置，因此同一厂商换模型只需这一行。
AI_FALLBACK_MODEL=agnes-image-2.5-flash

# 图库管理口令。本地 npm run dev 未设置时使用 dev-gallery-admin。生产环境请改成足够长的随机字符串。
# ADMIN_GALLERY_TOKEN=
# AI_FALLBACK_PROVIDER=
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_API_BASE=
# AI_FALLBACK_TIMEOUT_MS=

VITE_AI_PROMPT_PIPELINE_V2=false
VITE_AI_PROMPT_DEBUG=false

# Public client tokens. Production builds read .env.production.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_CLARITY_PROJECT_ID=
# Vision 默认复用 AGNES_API_KEY，并将 AGNES_API_BASE 自动换成 /v1/chat/completions；如需独立配置再覆盖
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=agnes-2.0-flash
