# ---- AI 图像生成：默认模型 ----
# 默认通过 ModelMux 的 OpenAI Responses 兼容接口调用 gpt-5.6-sol。
AI_DEFAULT_PROVIDER=openai-responses
AI_DEFAULT_API_KEY=your_api_key_here
AI_DEFAULT_API_BASE=https://modelmux.io/v1
AI_DEFAULT_MODEL=gpt-5.6-sol
AI_DEFAULT_TIMEOUT_MS=150000
AGNES_PROXY_PORT=8787

# PROVIDER 支持 openai-responses / openai-images。

# ---- AI 图像生成：备用模型（fallback）----
# 设置 AI_FALLBACK_MODEL 即启用：默认模型任何失败（报错、超时、未返回图片）都会用备用模型重试一次。
# 不同厂商建议完整配置下列 AI_FALLBACK_* 字段。
# AI_FALLBACK_PROVIDER=openai-images
# AI_FALLBACK_API_KEY=your_fallback_api_key_here
# AI_FALLBACK_API_BASE=https://example.com/v1/images/generations
# AI_FALLBACK_MODEL=agnes-image-2.5-flash
# AI_FALLBACK_TIMEOUT_MS=150000

# 图库管理口令。本地 npm run dev 未设置时使用 dev-gallery-admin。生产环境请改成足够长的随机字符串。
# ADMIN_GALLERY_TOKEN=

VITE_AI_PROMPT_PIPELINE_V2=false
VITE_AI_PROMPT_DEBUG=false

# Public client tokens. Production builds read .env.production.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_CLARITY_PROJECT_ID=
# Vision 使用独立配置
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=agnes-2.0-flash
