{
  "name": "perler-pattern-miniapp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "node scripts/build-platform.mjs weapp",
    "dev:xhs": "TARO_OUTPUT_ROOT=dist-xhs taro build --type xhs --watch",
    "build:xhs": "node scripts/build-platform.mjs xhs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@swc/core": "1.3.96",
    "@tarojs/cli": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/plugin-platform-xhs": "1.2.2",
    "@tarojs/webpack5-runner": "4.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "babel-preset-taro": "4.3.3",
    "typescript": "6.0.2"
  },
  "allowScripts": {
    "@swc/core@1.3.96": true,
    "@tarojs/binding@4.3.3": true,
    "@tarojs/cli@4.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
